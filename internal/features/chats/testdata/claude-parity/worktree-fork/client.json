{
  "timeout": "45s",
  "steps": [
    {"repo": {}},
    {"git": ["worktree", "add", "-q", ".worktrees/side", "-b", "side"]},
    {"initialize": {}},
    {"new": "s1", "meta": {"claudeCode": {"options": {"settings": {"permissions": {"allow": ["Bash", "Write", "Agent", "EnterWorktree", "ExitWorktree"]}}}}}},
    {"prompt": "enter the side worktree", "session": "s1", "async": "p1"},
    {"answer": "session/request_permission", "option": "allow_once"},
    {"await": "p1"},
    {"fork": "s1", "as": "s2", "meta": {"claudeCode": {"options": {"settings": {"permissions": {"allow": ["Bash", "Write", "Agent", "EnterWorktree", "ExitWorktree"]}}}}}},
    {"prompt": "where is the fork", "session": "s2"},
    {"fork": "s1", "as": "s3", "meta": {"jetbrains": {"air": {"fork": {"version": 1, "messageId": "msg_worktree_fork_point"}}}, "claudeCode": {"options": {"settings": {"permissions": {"allow": ["Bash", "Write", "Agent", "EnterWorktree", "ExitWorktree"]}}}}}},
    {"prompt": "where is the rewound fork", "session": "s3"},
    {"prompt": "where is the parent", "session": "s1"}
  ]
}
